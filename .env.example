# Skyggeby - miljøvariabler
#
# Dette er en MAL. Ekte verdier hører hjemme i server/.env lokalt (som er
# gitignorert) og i Railway sine variabler for staging. Ikke legg hemmeligheter
# i denne filen.
#
# Lokalt leses variablene fra server/.env - kopier server/.env.example dit.
# I Railway settes de samme navnene som service-variabler.

# ---------------------------------------------------------------- database ---
# Lokalt: PostgreSQL fra docker-compose.yml.
# Railway: referer til Postgres-tjenesten med ${{Postgres.DATABASE_URL}}
#          i stedet for å lime inn en tilkoblingsstreng.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyggeby?schema=public"

# ------------------------------------------------------------------ server ---
# Railway setter PORT selv. La den stå utsatt der.
PORT=4000
NODE_ENV=development

# Adressen serveren binder seg til. 0.0.0.0 kreves i container.
HOST=0.0.0.0

# ------------------------------------------------------------------- klient --
# Om denne prosessen også serverer den bygde frontenden. Standard: på i
# produksjon, av ellers. Trengs normalt ikke å settes.
# SERVE_CLIENT=true

# Kun nødvendig hvis frontend kjøres fra et ANNET origin enn API-et. Med
# samme-origin-oppsettet (som er standard i staging) skal denne stå urørt.
CLIENT_ORIGIN=http://localhost:5173

# Offentlig adresse. Brukes kun i oppstartsloggen.
# PUBLIC_APP_URL=https://<ditt-prosjekt>.up.railway.app

# ------------------------------------------------------------------ cookie ---
# Må være true bak HTTPS (staging), false lokalt over http.
COOKIE_SECURE=false

# ------------------------------------------------------------------- proxy ---
# Antall reverse proxyer foran API-et.
#   0 lokalt (serveren nås direkte)
#   1 i Railway (én proxy foran containeren)
# Settes den for høyt kan klienter forfalske X-Forwarded-For og få ny
# rate-limit-kvote for hver forespørsel.
TRUST_PROXY=0

# Skyggeby bruker ugjennomsiktige økt-tokens lagret i databasen, ikke signerte
# cookies. Det finnes derfor ingen SESSION_SECRET å sette.
