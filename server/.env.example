# PostgreSQL-tilkobling
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyggeby?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend-origin som får lov til å sende cookies (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Sett til "true" hvis appen kjøres bak HTTPS i produksjon
COOKIE_SECURE=false

# Antall reverse proxyer foran API-et. La stå 0 hvis serveren nås direkte.
# Settes den for høyt kan klienter forfalske X-Forwarded-For og omgå rate limit.
# I Railway skal denne være 1.
TRUST_PROXY=0

# Adressen serveren binder seg til. 0.0.0.0 kreves i container.
HOST=0.0.0.0

# Om denne prosessen også serverer den bygde klienten fra client/dist.
# Standard: på når NODE_ENV=production, av ellers.
# SERVE_CLIENT=true

# Offentlig adresse, kun brukt i oppstartsloggen.
# PUBLIC_APP_URL=https://<ditt-prosjekt>.up.railway.app
